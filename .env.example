# Airtable Personal Access Token (Account settings > Developer hub > Personal access tokens)
# Needs data.records:read and data.records:write scopes on the base below.
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Airtable Base ID (Help > API documentation, or the base URL: airtable.com/appXXXXXXXXXXXXXX/...)
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Name of the table holding inventory records. Defaults to "Inventory" if unset.
AIRTABLE_TABLE_NAME=Inventory
